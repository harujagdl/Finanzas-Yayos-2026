rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedOwner(o) {
      return o is string && (o == "haru" || o == "yair");
    }

    function canRead() {
      return resource.data.owner is string && isAllowedOwner(resource.data.owner);
    }

    function canCreate() {
      return request.resource.data.owner is string && isAllowedOwner(request.resource.data.owner);
    }

    function canUpdateOrDelete() {
      return resource.data.owner is string
        && isAllowedOwner(resource.data.owner)
        && request.resource.data.owner == resource.data.owner;
    }

    match /cards/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /expenses/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /goals/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /monthly_summaries/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }


    match /users/{userId}/notificationPreferences/{prefId} {
      allow read, write: if userId in ["haru", "yair"];
    }

    match /users/{userId}/pushDevices/{deviceId} {
      allow read, delete: if userId in ["haru", "yair"];
      allow create, update: if userId in ["haru", "yair"]
        && request.resource.data.token is string
        && request.resource.data.enabled is bool;
    }

    match /notificationLog/{notificationId} {
      allow read: if resource.data.userId in ["haru", "yair"];
      allow create, update, delete: if false;
    }


    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
