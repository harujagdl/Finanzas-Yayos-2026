rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowedOwner(o) {
      return o is string && (o == "haru" || o == "yair");
    }

    function canRead() {
      return resource.data.owner is string && isAllowedOwner(resource.data.owner);
    }

    function canCreate() {
      return request.resource.data.owner is string && isAllowedOwner(request.resource.data.owner);
    }

    function canUpdateOrDelete() {
      return resource.data.owner is string
        && isAllowedOwner(resource.data.owner)
        && request.resource.data.owner == resource.data.owner;
    }

    match /cards/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /expenses/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /goals/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /monthly_summaries/{id} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    match /familyMsiCommitments/{docId} {
      allow read: if canRead();
      allow create: if canCreate();
      allow update, delete: if canUpdateOrDelete();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
